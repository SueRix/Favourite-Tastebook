# Copy to .env ON THE SERVER and fill in. Never commit the filled version.
# Keep every secret free of "$": docker compose treats it as the start of a
# variable reference and eats the rest. token_urlsafe and rand -hex are safe.
SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
DEBUG=False

# 1.2.3.4 is the server's public IP. sslip.io resolves 1-2-3-4.sslip.io to it,
# which is what gives Caddy a hostname to get a certificate for.
SITE_ADDRESS=1-2-3-4.sslip.io
# "web" is required, not decorative: n8n calls the tool API at http://web:8000
# over the compose network, and Django rejects a Host it was not told about.
ALLOWED_HOSTS=1-2-3-4.sslip.io,1.2.3.4,web,localhost
CSRF_TRUSTED_ORIGINS=https://1-2-3-4.sslip.io

DB_ENGINE=django.db.backends.postgresql
DB_NAME=tastebook
DB_USER=tastebook
DB_PASSWORD=<openssl rand -hex 24>
DB_HOST=db
DB_PORT=5432

GEMINI_API_KEY=<key>

# n8n is reached over the compose network, not through Caddy.
N8N_PINECONE_WEBHOOK_URL=http://n8n:5678/webhook/recipe-vector-search
N8N_AGENT_WEBHOOK_URL=http://n8n:5678/webhook/cooking-agent
N8N_WEBHOOK_AUTH_TOKEN=<token>
N8N_WEBHOOK_TIMEOUT=5
VECTOR_SEARCH_TOP_K=20
AGENT_SERVICE_TOKEN=<token>

# Generate once and keep it. Lose it and every credential stored in n8n
# becomes unreadable, even with the volume intact.
N8N_ENCRYPTION_KEY=<openssl rand -hex 32>
